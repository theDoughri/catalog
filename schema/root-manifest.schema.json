{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baggo.app/catalog/schema/root-manifest.schema.json",
  "title": "Baggo catalog root manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "name", "version", "lists"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "catalog_id": {
      "$ref": "#/$defs/slug"
    },
    "name": {
      "$ref": "#/$defs/localizedName"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "lists": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "path", "name", "version"],
        "properties": {
          "slug": {
            "$ref": "#/$defs/slug"
          },
          "path": {
            "type": "string",
            "pattern": "^lists/[a-z0-9]+(-[a-z0-9]+)*/manifest\\.json$"
          },
          "name": {
            "$ref": "#/$defs/localizedName"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "localizedName": {
      "type": "object",
      "required": ["en", "fr", "es", "de", "ar"],
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z]{2}(-[A-Z]{2})?$": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
