{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baggo.app/catalog/schema/categories.schema.json",
  "title": "Baggo catalog global categories",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["slug", "icon", "name"],
    "properties": {
      "slug": {
        "$ref": "#/$defs/slug"
      },
      "icon": {
        "$ref": "#/$defs/slug"
      },
      "name": {
        "$ref": "#/$defs/localizedName"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "localizedName": {
      "type": "object",
      "required": ["en", "fr", "es", "de", "ar"],
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z]{2}(-[A-Z]{2})?$": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
